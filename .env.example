# Solana RPC endpoint (devnet for Colosseum demo)
RPC_URL=https://api.devnet.solana.com

# Path to the mint authority keypair (JSON array of secret key bytes)
# Generated by: npm run keygen
AUTHORITY_KEYPAIR=./keys/mint-authority.json

# Mint address of BitValue Coin (BVC) — filled automatically by create-token.js
# MINT_ADDRESS=

# Secret salt used to hash IMEI before putting a device fingerprint on-chain.
# Generate once with: openssl rand -hex 32
# Never reuse across environments. Never commit the real value.
DEVICE_SALT=replace_with_openssl_rand_hex_32
